{
  "name": "pahari-night-village",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Photorealistic living 3D Pahari hill-tract village at night with walking villagers, grazing animals, chimney smoke, fireflies, and procedural night audio.",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build",
    "preview": "vite preview",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "test": "node --test test/applet.test.mjs",
    "start": "node server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.170.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2"
  }
}
